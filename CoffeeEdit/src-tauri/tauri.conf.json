{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CoffeeEdit",
  "version": "1.0.0",
  "identifier": "com.coffeeworks.coffeeedit",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1426",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CoffeeEdit",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": false,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}